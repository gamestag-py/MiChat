# Copy to .env and replace every placeholder.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=michat_app
DB_PASSWORD=change_this_password
DB_NAME=michat

DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_CHARSET=utf8mb4
DB_HEALTH_CHECK_INTERVAL=30
DB_MAX_RETRIES=5
DB_RETRY_BASE_DELAY=0.25
DB_RETRY_MAX_DELAY=8.0
